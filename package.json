{
  "name": "widecast",
  "version": "0.1.0",
  "description": "面向 AI agent 的自媒体多平台管理工具 — DeepSeek Harness 原生插件(账号管理 / 草稿 / 发布队列 / 数据 / 设置)",
  "type": "module",
  "license": "MIT",
  "author": "astra3294",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astra3294/widecast.git"
  },
  "homepage": "https://github.com/astra3294/widecast#readme",
  "bugs": {
    "url": "https://github.com/astra3294/widecast/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "self-media",
    "自媒体",
    "publish",
    "agent",
    "mcp-alternative"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.6.0",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "pnpm clean && pnpm build:types && tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.20",
    "react": "^18.3.1",
    "tsdown": "^0.16.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
